{
  "name": "bare-pare-chat",
  "version": "1.0.0",
  "description": "P2P terminal chat over Bare/Pear + Hyperswarm, written in ClojureScript",
  "main": "build/index.js",
  "pear": {
    "name": "bare-pare-chat",
    "type": "terminal",
    "main": "build/index.js"
  },
  "scripts": {
    "build": "shadow-cljs release app",
    "watch": "shadow-cljs watch app",
    "repl": "shadow-cljs watch app",
    "start": "pear run -d ."
  },
  "dependencies": {
    "hyperswarm": "^4.7.0",
    "b4a": "^1.6.6"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.0"
  }
}
